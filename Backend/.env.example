# MySQL connection string (MySQL debe estar corriendo antes de iniciar el backend)
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/identidad_digital_ssi"

# Puerto HTTP del backend (opcional, por defecto 3000)
PORT=3000

# --- Blockchain (opcional) ---
# Si faltan estas variables, BlockchainService arranca en modo "no listo":
# el backend sigue funcionando pero las credenciales no se anclan on-chain.
BESU_RPC_URL="http://127.0.0.1:8545"
BLOCKCHAIN_PRIVATE_KEY="TU_CLAVE_PRIVADA"
CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"

# --- SMTP / Email (opcional) ---
# Si faltan SMTP_HOST, SMTP_USER o SMTP_PASS, MailService arranca en modo
# "no listo": el backend sigue funcionando pero los correos se omiten
# (solo se loguea que el envio fue saltado, nunca rompe el flujo de negocio).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu-correo@gmail.com"
# Si usas Gmail, SMTP_PASS debe ser un "App Password" generado en tu cuenta de
# Google (Seguridad > Verificacion en dos pasos > Contrasenas de aplicaciones),
# NO tu contrasena normal de Gmail.
SMTP_PASS="tu-app-password"
# Direccion que aparece como remitente; si se omite se usa SMTP_USER.
SMTP_FROM="tu-correo@gmail.com"
