// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Rol {
  CIUDADANO
  ADMIN
  INSTITUCION
}

model Usuario {
  id            Int           @id @default(autoincrement())
  nombre        String
  identificacion String?      @unique
  email         String        @unique
  password      String        @default("123456") // In a real app, don't use default plain text, but for migrating existing rows this prevents errors
  rol           Rol           @default(CIUDADANO)
  wallet        String?       @unique
  did           String?       @unique
  activo        Boolean       @default(true)
  createdAt     DateTime      @default(now())

  institucionId Int?          @unique
  institucion   Institucion?  @relation(fields: [institucionId], references: [id])

  credenciales  Credencial[]
  solicitudes   Solicitud[]
  notificaciones Notificacion[]
}

model Institucion {
  id            Int           @id @default(autoincrement())
  nombre        String
  tipo          String
  wallet        String?       @unique
  activo        Boolean       @default(true)
  createdAt     DateTime      @default(now())

  usuario       Usuario?

  credenciales  Credencial[]
  solicitudes   Solicitud[]
  atributos     InstitucionAtributo[]
  tramites      Tramite[]
}

enum AtributoIdentidad {
  ESTADO_CIVIL
  PORCENTAJE_DISCAPACIDAD
  NUMERO_RUC
  ESTADO_TRIBUTARIO_AL_DIA
  LICENCIA_CATEGORIAS
  SALDO_PUNTOS_LICENCIA
  TIENE_BIENES_INMUEBLES
  BIENES_LIBRES_GRAVAMEN
  ANTECEDENTES_PENALES_LIMPIO
  ESTATUS_SERVICIO_MILITAR
  PERMISO_ARMAS_ACTIVO
  TITULO_PRINCIPAL
  NUMERO_REGISTRO_SENESCYT
  ESTADO_AFILIACION_IESS
  DERECHO_ATENCION_MEDICA
}

model InstitucionAtributo {
  id            Int               @id @default(autoincrement())
  institucionId Int
  atributo      AtributoIdentidad
  institucion   Institucion       @relation(fields: [institucionId], references: [id], onDelete: Cascade)

  @@unique([institucionId, atributo])
}

model Tramite {
  id            Int         @id @default(autoincrement())
  institucionId Int
  nombre        String
  descripcion   String?
  activo        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  institucion   Institucion @relation(fields: [institucionId], references: [id], onDelete: Cascade)
}

model Credencial {
  id              Int          @id @default(autoincrement())

  titulo          String
  descripcion     String

  hashBlockchain  String?

  emitidaEn       DateTime     @default(now())
  fechaCaducidad  DateTime?
  firmaEmisorHash String?

  usuarioId       Int
  institucionId   Int
  solicitudId     Int?         @unique

  usuario         Usuario      @relation(fields: [usuarioId], references: [id])

  institucion     Institucion  @relation(fields: [institucionId], references: [id])
  solicitud       Solicitud?   @relation(fields: [solicitudId], references: [id])
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoIdentidad {
  CEDULA
  DISCAPACIDAD
}

model Solicitud {
  id              Int             @id @default(autoincrement())
  tipoCredencial  TipoIdentidad
  datosJSON       String          @db.Text
  estado          EstadoSolicitud @default(PENDIENTE)
  hashTemporal    String?         @unique
  usuarioId       Int
  institucionId   Int
  createdAt       DateTime        @default(now())

  usuario         Usuario         @relation(fields: [usuarioId], references: [id])
  institucion     Institucion     @relation(fields: [institucionId], references: [id])
  credencial      Credencial?
}

model Notificacion {
  id                     Int      @id @default(autoincrement())
  destinatarioUsuarioId  Int
  destinatario           Usuario  @relation(fields: [destinatarioUsuarioId], references: [id], onDelete: Cascade)
  titulo                 String
  mensaje                String
  leida                  Boolean  @default(false)
  createdAt              DateTime @default(now())
}